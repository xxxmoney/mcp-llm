{
	"name": "mcp-llm",
	"version": "1.0.1",
	"description": "MCP server for communication with LLM through OpenAI API standard",
	"main": "index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsup src/index.ts src/stdio.ts --format esm",
		"start": "node dist/index.js",
		"lint": "biome check --write",
		"docker-up": "docker compose --env-file .env up --build -d",
		"docker-down": "docker compose down",
		"docker-up:dev": "docker compose --env-file .env.dev -f docker-compose.yaml -f docker-compose.dev.yaml up --build -d",
		"docker-down:dev": "docker compose -f docker-compose.yaml -f docker-compose.dev.yaml down",
		"inspect-http": "dotenv -e .env -- cross-var inspector http://localhost:%EXTERNAL_PORT%/mcp",
		"inspect-http:dev": "dotenv -e .env.dev -- cross-var inspector http://localhost:%EXTERNAL_PORT%/mcp",
		"inspect-stdio": "inspector docker exec -i mcp-llm-prod node dist/stdio.js",
		"inspect-stdio:dev": "inspector docker exec -i mcp-llm-dev npx tsx src/stdio.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"dependencies": {
		"@fastify/cors": "^11.3.0",
		"@fastify/type-provider-zod": "^1.0.0",
		"@modelcontextprotocol/fastify": "^2.0.0",
		"@modelcontextprotocol/node": "^2.1.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"dotenv": "^18.0.3",
		"fastify": "^5.12.5",
		"openai": "^7.23.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@modelcontextprotocol/inspector": "^2.12.0",
		"@types/node": "^26.6.2",
		"cross-var": "^1.1.0",
		"dotenv-cli": "^11.0.0",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
