{
	"name": "mcp-llm",
	"version": "1.0.0",
	"description": "MCP server for communication with LLM through OpenAI API standard",
	"main": "index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsup src/index.ts --format esm",
		"start": "node dist/index.js",
		"lint": "biome check --write",
		"docker-up": "docker compose up --build -d",
		"docker-up:dev": "docker compose -f docker-compose.yaml -f docker-compose.dev.yaml up --build -d",
		"docker-down": "docker compose down"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"dependencies": {
		"@fastify/cors": "^11.3.0",
		"@fastify/type-provider-zod": "^1.0.0",
		"@modelcontextprotocol/fastify": "^2.0.0",
		"@modelcontextprotocol/node": "^2.1.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"dotenv": "^18.0.3",
		"fastify": "^5.12.5",
		"openai": "^7.23.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "^26.6.2",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
